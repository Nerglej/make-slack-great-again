+    st.append(HZIP_EXTENSION);
+    hin = new Hunzip(st.c_str(), key);
+  }
+  if (!fin && !hin->is_open())
+    fail(MSG_OPEN, file);
+}
+
+FileMgr::~FileMgr() {
+  if (fin)
